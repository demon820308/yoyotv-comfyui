{
  "name": "yoyotv-comfyui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "easy": "node scripts/yoyotv-easy.mjs start",
    "easy:setup": "node scripts/yoyotv-easy.mjs setup",
    "easy:stop": "node scripts/yoyotv-easy.mjs stop",
    "easy:doctor": "node scripts/yoyotv-easy.mjs doctor",
    "easy:remote": "node scripts/yoyotv-easy.mjs remote",
    "easy:restore": "node scripts/yoyotv-easy.mjs restore",
    "dev": "pnpm --parallel --filter @yoyotv/server --filter @yoyotv/web dev",
    "dev:web": "pnpm --filter @yoyotv/web dev",
    "dev:server": "pnpm --filter @yoyotv/server dev",
    "portal:dev": "pnpm --filter @yoyotv/portal... build && pnpm --filter @yoyotv/portal dev",
    "portal:build": "pnpm --filter @yoyotv/portal... build",
    "portal:start": "node apps/portal/dist/index.js",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:functional": "pnpm build && playwright test --grep-invert @performance",
    "test:e2e:performance": "pnpm build && playwright test --grep @performance",
    "gate:release": "pnpm verify && pnpm test:e2e",
    "gate:gpu": "node scripts/gpu-release-gate.mjs",
    "compatibility:matrix": "node scripts/build-compatibility-matrix.mjs",
    "demo:capture": "pnpm build && node scripts/capture-product-demo.mjs",
    "desktop:prepare": "pnpm --filter @yoyotv/desktop prepare-runtime",
    "desktop:check": "pnpm --filter @yoyotv/desktop check",
    "desktop:bundle": "pnpm --filter @yoyotv/desktop bundle",
    "security:linux-desktop": "node scripts/check-linux-desktop-advisory.mjs",
    "bundle:verify": "node scripts/verify-release-checksums.mjs release",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm security:linux-desktop && pnpm compatibility:matrix -- --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
